from array_api_compat import array_namespace

def psi_vec(x):
    '''
    (array-vectorized) Exponential decay on the positive half, zero below it.

    Notes:
        Vectorized by array-vectorize from this scalar original::

            @array_vectorize.vectorize
            def psi(x: float) -> float:
                """Exponential decay on the positive half, zero below it."""
                if x < 0:
                    return 0.0
                return x * math.exp(-x)
    '''
    xp = array_namespace(x)
    return xp.where(x < 0, 0.0, x * xp.exp(xp.astype(xp.asarray(-x), xp.float64)))

from array_api_compat import array_namespace

def clamp_vec(x, lo=0.0, hi=1.0):
    '''
    (array-vectorized) Clamp x into [lo, hi].

    Notes:
        Vectorized by array-vectorize from this scalar original::

            @array_vectorize.vectorize
            def clamp(x: float, lo: float = 0.0, hi: float = 1.0) -> float:
                """Clamp x into [lo, hi]."""
                if x < lo:
                    return lo
                if x > hi:
                    return hi
                return x
    '''
    xp = array_namespace(x, lo, hi)
    return xp.where(x < lo, lo, xp.where(x > hi, hi, x))

