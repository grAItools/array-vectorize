from array_api_compat import array_namespace

def gelu_vec(x):
    '''
    (array-vectorized) GELU activation (tanh approximation).

    Notes:
        Vectorized by array-vectorize from this scalar original::

            @array_vectorize.vectorize
            def gelu(x):
                """GELU activation (tanh approximation)."""
                return 0.5 * x * (1.0 + math.tanh(0.7978845608028654 * (x + 0.044715 * x * x * x)))
    '''
    xp = array_namespace(x)
    return 0.5 * x * (1.0 + xp.tanh(xp.astype(xp.asarray(0.7978845608028654 * (x + 0.044715 * x * x * x)), xp.float64)))

